# ----- Server -----
NODE_ENV=development
PORT=3002
INTERNAL_AUTH_SECRET=change-me-at-least-16-chars

BACKEND_PUBLIC_URL=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,https://www.skillbridgebuilder.com

# ----- API Docs -----
API_DOCS_ENABLED=true
API_DOCS_PATH=reference
OPENAPI_JSON_PATH=openapi.json

# ----- Auth -----
JWT_ACCESS_SECRET=change-me-strong-random
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-different-strong-random
JWT_REFRESH_TTL=1209600
GOOGLE_CLIENT_ID=

# ----- Email / Resend -----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=SkillBridge <noreply@your-verified-domain.com>
EMAIL_VERIFY_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# ----- LLM Providers -----
# OpenAI is the default text/embedding provider for current scoring and matching flows.
LLM_PROVIDER_DEFAULT=openai

OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.4-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-large
LEARNING_CONTENT_AI_ENABLED=false
# Optional model override for one-shot Learning lesson condensation.
LEARNING_CONTENT_AI_MODEL=
# Optional transient UI translation. LibreTranslate is tried first; Google Cloud
# Translation is an opt-in fallback that uses Application Default Credentials.
LEARNING_TRANSLATION_LIBRE_URL=
LEARNING_TRANSLATION_LIBRE_API_KEY=
LEARNING_TRANSLATION_TIMEOUT_MS=5000
LEARNING_TRANSLATION_GOOGLE_ENABLED=false
LEARNING_TRANSLATION_GOOGLE_PROJECT_ID=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_VOICE=marin

# CV/JD matching: v1 is the safe baseline; set v2 only after drift/staging checks.
CV_JD_MATCH_TEMPLATE_CODE=cv_jd_match_v1

# Stabilizes repeated CV/JD scoring by caching only the LLM extraction payload.
# Disable quickly if needed: CV_JD_MATCH_EXTRACTION_CACHE_ENABLED=false
CV_JD_MATCH_EXTRACTION_CACHE_ENABLED=true

# Interview chain model routing.
# Assessment and ask generation use cheap deterministic models by default. Leave the other two
# blank to use the provider default unless you need targeted routing.
INTERVIEW_ASSESS_MODEL=gpt-4o-mini
INTERVIEW_ASK_MODEL=gpt-4o-mini
ANSWER_INSIGHT_MODEL=
INTERVIEW_COACHING_MODEL=

# CV-diagnosis advisor (mascot chat). Blank → provider default. _LIGHT routes ONLY the light
# intents (compare_jd) to a cheaper model; blank → same as DIAGNOSIS_CHAT_MODEL. Any model
# change requires re-running the fabrication corpus + one live run BEFORE deploy.
DIAGNOSIS_CHAT_MODEL=
DIAGNOSIS_CHAT_MODEL_LIGHT=

# CV-writing judge (calibration only, scores quality — not fabrication, that's a deterministic
# gate). MUST differ from CV_BUILDER_CHAT_MODEL — a judge grading its own model's prose
# self-inflates scores. Blank → falls back to gpt-4o.
CV_WRITING_JUDGE_MODEL=

# ----- Database (Postgres + pgvector) -----
# Supabase is used as the Postgres host only. Auth still belongs to this NestJS backend.
DATABASE_URL=postgres://user:password@localhost:5432/skillbridge
# Set true for Supabase hosted Postgres.
DB_SSL=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# ----- Vector / Semantic Skill Matching -----
VECTOR_DIMENSION=1024
VECTOR_TABLE=document_chunks
VECTOR_COLUMN=embedding
VECTOR_EMBEDDING_VERSION=v1
SEMANTIC_ACCEPT_THRESHOLD=0.72
SEMANTIC_REVIEW_BAND=0.08
SEMANTIC_MAX_PER_CV=16

# ----- File Storage (Google Cloud Storage) -----
# Bucket stays private; files are downloaded through authenticated API endpoints.
# On Cloud Run, auth uses ADC/service account metadata. Do not commit service account keys.
GCS_BUCKET=your-gcs-bucket-name
GCS_PROJECT_ID=

# Optional. When omitted, Puppeteer uses its bundled/default browser.
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ----- payOS -----
PAYMENT_PROVIDER=PAYOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8080/billing/checkout
PAYOS_CANCEL_URL=http://localhost:8080/billing/checkout
PAYOS_CHECKOUT_ALLOWED_ORIGINS=http://localhost:8080,https://skillbridgebuilder.com,https://www.skillbridgebuilder.com
PAYOS_WEBHOOK_URL=http://localhost:3002/api/billing/payos/webhook
PAYOS_PARTNER_CODE=

# ----- Quota / Rate Limiting -----
CV_REVIEW_DAILY_LIMIT=5
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ----- Observability -----
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
